# Variables de entorno de referencia (copiar a .env en el servidor; NUNCA versionar .env).
# En GitHub se capturan como Secrets/Variables del repositorio o de cada Environment.

# Base de datos (usuario dedicado, nunca root)
DB_NAME=artesanias_huejutla
DB_USER=ah_wp
DB_PASSWORD=
DB_HOST=localhost

# Entorno de WordPress: local | staging | production
WP_ENVIRONMENT_TYPE=production
WP_HOME=https://www.artesaniashuejutla.mx
WP_SITEURL=https://www.artesaniashuejutla.mx

# Claves de seguridad: generar en https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# Correo saliente (SMTP). Ejemplo con Brevo: crea una clave SMTP en Brevo → SMTP & API.
AH_SMTP_HOST=
AH_SMTP_PORT=587
AH_SMTP_SECURE=tls
AH_SMTP_USER=
AH_SMTP_PASS=
AH_SMTP_FROM=
AH_SMTP_FROM_NAME="Artesanías Huejutla"
