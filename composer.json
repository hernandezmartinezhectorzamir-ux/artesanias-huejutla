{
	"name": "itsh/artesanias-huejutla",
	"description": "Tema y plugin de WordPress/WooCommerce para Artesanías Huejutla (Gestiones Tecnológicas Empresariales, ISC – ITS Huejutla).",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"scripts": {
		"lint": "find wp-content/themes/artesanias-huejutla wp-content/plugins/ah-gestion-ti -name '*.php' -print0 | xargs -0 -n1 php -l",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"test": "phpunit"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	}
}
